DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.development
# AI provider: gemini (default) or deepseek
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-flash
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
# NOTE: Update the value below once Vercel generates your actual production URL
CORS_ALLOWED_ORIGINS=https://instant-mechanic-frontend.vercel.app
# Production only: set to False until certbot has issued a TLS certificate
SECURE_SSL_REDIRECT=True
